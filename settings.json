{
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "fable",
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "gitkraken-hooks@gitkraken": false
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "gitkraken": {
      "source": {
        "source": "directory",
        "path": "/home/jaamo/.claude/plugins/marketplaces/gitkraken"
      }
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "agentPushNotifEnabled": true
}
